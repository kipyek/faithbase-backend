generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  LEAD_PASTOR
  STAFF
}

enum ChurchType {
  NATIONAL
  REGIONAL
  LOCAL
}

model Church {
  id    String     @id @default(uuid())
  name  String
  email String     @unique
  type  ChurchType

  parentId String?
  parent   Church?  @relation("Hierarchy", fields: [parentId], references: [id])
  children Church[] @relation("Hierarchy")

  users   User[]
  members Member[]

  createdAt DateTime @default(now())
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role

  churchId String?
  church   Church? @relation(fields: [churchId], references: [id])

  createdAt DateTime   @default(now())
  auditLogs AuditLog[]
}

model Member {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  phone     String?

  churchId String
  church   Church @relation(fields: [churchId], references: [id])

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action   String
  entity   String
  entityId String?

  metadata Json?

  createdAt DateTime @default(now())
}
